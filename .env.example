# Firebase (client-safe)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Sign-up is closed. Omit to use the built-in allowlist in src/lib/auth-allowed.ts,
# or set this (comma-separated) to override which existing Firebase accounts may sign in.
# VITE_AUTH_ALLOWED_EMAILS=you@example.com
# Enable Firestore in Firebase Console → Build → Firestore Database.
# Deploy firestore.rules so signed-in users can read/write users/{uid}/tradeLogs/*.

# Zerodha Kite Connect (server-only)
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
# Optional: prefer a pinned Vercel egress IP when relay/proxy is configured.
# KITE_TRADING_IP=175.184.252.162
# IPs registered in Kite Connect (comma-separated). Defaults to 175.184.252.162 and 122.186.158.142.
# KITE_WHITELIST_IPS=175.184.252.162,122.186.158.142,119.226.255.113
# Route local Kite API through Vercel only when KITE_EGRESS_RELAY_URL is set AND production egress is whitelisted.
# KITE_EGRESS_RELAY_URL=https://options-trading-yhys.vercel.app
# Same secret as on Vercel (Settings → Environment Variables). Required for relay.
KITE_RELAY_SECRET=
# MARKET / SL-M orders require market_protection: -1 (auto) or 1–100 (custom % band)
KITE_MARKET_PROTECTION=-1

# App URL for OAuth redirect (production: https://options-trading-yhys.vercel.app)
APP_URL=http://localhost:5173

# --- Vercel production (Settings → Environment Variables) ---
# Set ALL vars above on Vercel for Production + Preview.
# APP_URL=https://options-trading-yhys.vercel.app
# KITE_WHITELIST_IPS=175.184.252.162,122.186.158.142,119.226.255.113
# KITE_RELAY_SECRET=<random secret — same in .env.local for local dev relay>
# After first deploy: open Settings → Trading IP and whitelist the shown Vercel egress IP in Kite Connect.
# Kite redirect URL: https://options-trading-yhys.vercel.app/api/kite/callback

# --- AWS Lightsail (static IP + server 9:16 bot) ---
# See DEPLOY-LIGHTSAIL.md for full guide.
# NINE_SIXTEEN_BOT_ENABLED=1
# Max lots from available balance (0 = no cap). Example: 3 limits to 3 lots even if balance allows more.
# NINE_SIXTEEN_MAX_LOTS=0
# Keep this % of balance unused when sizing (default 5).
# NINE_SIXTEEN_BALANCE_BUFFER_PCT=0
# Extra % on option LTP when estimating cost per lot for market orders (default 2).
# NINE_SIXTEEN_LTP_ESTIMATE_BUFFER_PCT=0
# P&L exits: +10% 9:16–10:00 IST, +5% 10:01–11:00, +3% from 11:01 (see server/nine-sixteen-logic.ts).
# REST fallback quote poll when the websocket is down (ms). Default 1000; min 1000 — Kite allows 1 /quote per second.
# NINE_SIXTEEN_SPOT_POLL_MS=1000
# 9:15 open/close come from Kite websocket ticks (not historical candles). Lightsail IP must stay whitelisted.
# KITE_WHITELIST_IPS=YOUR_LIGHTSAIL_STATIC_IP,122.186.158.142
# KITE_TRADING_IP=YOUR_LIGHTSAIL_STATIC_IP
# APP_URL=https://trade.yourdomain.com
# Do not set KITE_EGRESS_RELAY_URL on Lightsail.
