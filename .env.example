# Firebase (client-safe)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Zerodha Kite Connect (server-only)
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
# Optional: prefer a pinned Vercel egress IP when relay/proxy is configured.
# KITE_TRADING_IP=175.184.252.162
# IPs registered in Kite Connect (comma-separated). Defaults to 175.184.252.162 and 122.186.158.142.
# KITE_WHITELIST_IPS=175.184.252.162,122.186.158.142,119.226.255.113
# Route local Kite API through Vercel only when KITE_EGRESS_RELAY_URL is set AND production egress is whitelisted.
# KITE_EGRESS_RELAY_URL=https://options-trading-yhys.vercel.app
# Same secret as on Vercel (Settings → Environment Variables). Required for relay.
KITE_RELAY_SECRET=
# MARKET / SL-M orders require market_protection: -1 (auto) or 1–100 (custom % band)
KITE_MARKET_PROTECTION=-1

# App URL for OAuth redirect (production: https://options-trading-yhys.vercel.app)
APP_URL=http://localhost:5173

# --- Vercel production (Settings → Environment Variables) ---
# Set ALL vars above on Vercel for Production + Preview.
# APP_URL=https://options-trading-yhys.vercel.app
# KITE_WHITELIST_IPS=175.184.252.162,122.186.158.142,119.226.255.113
# KITE_RELAY_SECRET=<random secret — same in .env.local for local dev relay>
# After first deploy: open Settings → Trading IP and whitelist the shown Vercel egress IP in Kite Connect.
# Kite redirect URL: https://options-trading-yhys.vercel.app/api/kite/callback

# Google Gemini (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_CACHE_MS=1000
# -1 = dynamic thinking (model chooses budget). Use a high fixed cap e.g. 32768 if needed.
GEMINI_THINKING_BUDGET=-1
GEMINI_MAX_OUTPUT_TOKENS=8192
# Entry-timing cache for AI auto-trade (default 10s between fresh Gemini entry checks)
GEMINI_ENTRY_CACHE_MS=10000
