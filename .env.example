# Firebase (client-safe)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: restrict sign-in to these emails (comma-separated). Omit to allow any existing Firebase user.
# VITE_AUTH_ALLOWED_EMAILS=you@example.com
# Enable Firestore in Firebase Console → Build → Firestore Database.
# Deploy firestore.rules so signed-in users can read/write users/{uid}/tradeLogs/*.

# Zerodha Kite Connect (server-only)
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
# Optional: prefer a pinned Vercel egress IP when relay/proxy is configured.
# KITE_TRADING_IP=175.184.252.162
# IPs registered in Kite Connect (comma-separated). Defaults to 175.184.252.162 and 122.186.158.142.
# KITE_WHITELIST_IPS=175.184.252.162,122.186.158.142,119.226.255.113
# Route local Kite API through Vercel only when KITE_EGRESS_RELAY_URL is set AND production egress is whitelisted.
# KITE_EGRESS_RELAY_URL=https://options-trading-yhys.vercel.app
# Same secret as on Vercel (Settings → Environment Variables). Required for relay.
KITE_RELAY_SECRET=
# MARKET / SL-M orders require market_protection: -1 (auto) or 1–100 (custom % band)
KITE_MARKET_PROTECTION=-1

# App URL for OAuth redirect (production: https://options-trading-yhys.vercel.app)
APP_URL=http://localhost:5173

# --- Daily headless Kite login (server-only, Lightsail) ---
# Zerodha flushes every access token between ~05:00 and 07:30 IST. With these set the server logs
# in again at 07:40 IST (retrying every 90s) and writes data/kite-session.json, so the 9:16 bot and
# the web UI are connected before market open with no manual tap.
# Zerodha's stated policy is that you log in manually once a day; enable this at your own discretion.
# KITE_AUTO_LOGIN_ENABLED=1
# Your Kite client ID, e.g. AB1234.
# KITE_USER_ID=
# Your Kite login password (NOT the 6-digit PIN).
# KITE_PASSWORD=
# Base32 setup key — NOT the 6-digit code, and NOT available with Zerodha-app-only 2FA.
# Enable "External TOTP" in Kite app → Profile → Manage → Enable external TOTP → Can't Scan? Copy the Key.
# KITE_TOTP_SECRET=

# --- Vercel production (Settings → Environment Variables) ---
# Set ALL vars above on Vercel for Production + Preview.
# APP_URL=https://options-trading-yhys.vercel.app
# KITE_WHITELIST_IPS=175.184.252.162,122.186.158.142,119.226.255.113
# KITE_RELAY_SECRET=<random secret — same in .env.local for local dev relay>
# After first deploy: open Settings → Trading IP and whitelist the shown Vercel egress IP in Kite Connect.
# Kite redirect URL: https://options-trading-yhys.vercel.app/api/kite/callback

# --- AWS Lightsail (static IP + server 9:16 bot) ---
# See DEPLOY-LIGHTSAIL.md for full guide.
# NINE_SIXTEEN_BOT_ENABLED — ignored. 9:16 trading is always off at startup; arm only from the UI.
# Traps live bot: signal candle range (high - low) > 2 pts; on the next minute the bot watches
# websocket ticks for the first 10 seconds. Nifty must reach close + 0.2 for CE or close - 0.2 for
# PE. If the gate is seen, it buys the ATM leg at market at second :11 of that minute only when
# Wilder RSI(14) on Nifty 1-min websocket closes is in 0–10, 40–50, or 70–100 (recomputed every tick).
# After entry
# the standard P&L ladder runs: first rung +0.50%, second +0.70%, then +1% and +0.5% steps — stop -4% with no hold, frozen at entry.
# sat out because it was by far the worst window in the Aug 26-28 option-candle backtest, which also
# leaves the wider 09:15-09:20 opening ladder (+5% steps, stop below -10% held 15s) unreachable
# though still in the code. New entries stop 15:10 and an open leg is force-squared at 15:25.
# There is no env switch
# to arm it: it boots disabled and is armed from the Enable bot control, so a deploy cannot restart it.
# Traps starts disabled — press Enable in the UI to arm. Entry windows: 10:30–12:00 & 13:45–15:10 IST.
# Lots per Traps entry (default 25), bought as ONE MIS market order — never split.
# Values above the per-order freeze limit are clamped down, since a bigger size would not split.
# Balance above this is left unused: a second order would leave part of the position untracked.
# MOMENTUM_SCALPER_MAX_LOTS=25
# Head-room % added to the premium when sizing the entry (default 2). A market buy lifts the ask and
# pays charges, so sizing on the last print alone is what produces insufficient-funds rejections.
# If one happens anyway the entry is re-sent up to 3 times at a smaller lot count rather than lost.
# MOMENTUM_SCALPER_PREMIUM_SAFETY_PCT=2
# Max lots from available balance (0 = no cap). Applies to BOTH bots — they share the sizing helper.
# NINE_SIXTEEN_MAX_LOTS=0
# Keep this % of balance unused when sizing (default 0 = use the full balance). Applies to both bots.
# NINE_SIXTEEN_BALANCE_BUFFER_PCT=0
# Extra % on option LTP when estimating cost per lot for market orders (default 0). Applies to both bots.
# NINE_SIXTEEN_LTP_ESTIMATE_BUFFER_PCT=0
# Max lots in a single Kite order (default 25, the Nifty MIS freeze limit). Caps Traps size.
# NINE_SIXTEEN_MAX_LOTS_PER_ORDER=25
# 9:16 P&L exit: custom trailing ladder (+8 Tue/Fri; +4 Mon/Wed · +5 Thu first tier — see server/nine-sixteen-logic.ts).
# 9:16 hard stop: ±30 index pts against the entry spot, scanning from 9:55 IST.
# REST fallback quote poll when the websocket is down (ms). Default 1000; min 1000 — Kite allows 1 /quote per second.
# NINE_SIXTEEN_SPOT_POLL_MS=1000
# 9:15 open/close come from Kite websocket ticks (not historical candles). Lightsail IP must stay whitelisted.
# KITE_WHITELIST_IPS=YOUR_LIGHTSAIL_STATIC_IP,122.186.158.142
# KITE_TRADING_IP=YOUR_LIGHTSAIL_STATIC_IP
# APP_URL=https://trade.yourdomain.com
# Do not set KITE_EGRESS_RELAY_URL on Lightsail.
