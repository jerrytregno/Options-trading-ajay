# Firebase (client-safe)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Zerodha Kite Connect (server-only)
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret

# App URL for OAuth redirect (production: https://options-trading-yhys.vercel.app)
APP_URL=http://localhost:5173

# Google Gemini (server-only) — https://ai.google.dev/gemini-api/docs/models/gemini-3.5-flash
# Model limits: 1,048,576 input tokens · 65,536 output tokens
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_CACHE_MS=1000
# -1 = dynamic thinking (model chooses budget up to max output tokens). Or set e.g. 32768 for a fixed cap.
GEMINI_THINKING_BUDGET=-1
GEMINI_MAX_OUTPUT_TOKENS=65536
# Entry-timing checks for AI auto-trade (default 15s between Gemini calls)
GEMINI_ENTRY_CACHE_MS=15000
